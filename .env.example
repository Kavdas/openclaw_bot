# ---- OpenClaw ----
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_TZ=Asia/Almaty
# Токен для Control UI / CLI. Сгенерировать: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# ---- Telegram (бот от @BotFather) ----
TELEGRAM_BOT_TOKEN=

# ---- LLM: OpenRouter (работает из РФ без VPN, есть бесплатные модели) ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Обход блокировки api.telegram.org (Cloudflare Worker) ----
# Корень Bot API без /bot<TOKEN>. Оставить пустым = прямой api.telegram.org
TELEGRAM_API_ROOT=
